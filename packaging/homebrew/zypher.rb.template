class {{HOMEBREW_CLASS}} < Formula
  desc "Batteries-included web framework built the Zig way"
  homepage "https://github.com/zypher-org/zypher"
  version "{{VERSION}}"
  license "Apache-2.0"

  on_macos do
    if Hardware::CPU.arm?
      url "{{BASE_URL}}/zypher-v{{VERSION}}-aarch64-macos.tar.gz"
      sha256 "{{SHA_AARCH64_MACOS}}"
    else
      url "{{BASE_URL}}/zypher-v{{VERSION}}-x86_64-macos.tar.gz"
      sha256 "{{SHA_X86_64_MACOS}}"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "{{BASE_URL}}/zypher-v{{VERSION}}-aarch64-linux-musl.tar.gz"
      sha256 "{{SHA_AARCH64_LINUX}}"
    else
      url "{{BASE_URL}}/zypher-v{{VERSION}}-x86_64-linux-musl.tar.gz"
      sha256 "{{SHA_X86_64_LINUX}}"
    end
  end

  def install
    libexec.install Dir["zypher*"].first => "zypher-bin"
    (share/"zypher/source").install Dir["source/*"]
    (bin/"zypher").write <<~SH
      #!/bin/sh
      set -eu

      zig_version="{{ZIG_VERSION}}"
      version="{{VERSION}}"
      zypher_home="${ZYPHER_HOME:-$HOME/.zypher}"
      source_dir="$zypher_home/source/$version"

      case "$(uname -s)-$(uname -m)" in
        Darwin-arm64) zig_target="aarch64-macos" ;;
        Darwin-aarch64) zig_target="aarch64-macos" ;;
        Darwin-x86_64) zig_target="x86_64-macos" ;;
        Linux-arm64) zig_target="aarch64-linux" ;;
        Linux-aarch64) zig_target="aarch64-linux" ;;
        Linux-x86_64) zig_target="x86_64-linux" ;;
        *) echo "zypher: unsupported platform for pinned Zig toolchain: $(uname -s) $(uname -m)" >&2; exit 1 ;;
      esac

      zig_dir="$zypher_home/zig/$zig_version/$zig_target"
      if [ ! -x "$zig_dir/zig" ]; then
        tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/zypher-zig.XXXXXX")"
        trap 'rm -rf "$tmp_dir" "$zig_dir.partial-$$"' EXIT INT TERM
        mkdir -p "$(dirname "$zig_dir")"
        zig_archive_name="zig-$zig_target-$zig_version.tar.xz"
        index="$tmp_dir/index.json"
        curl -fsSL "https://ziglang.org/download/index.json" -o "$index"
        if command -v jq >/dev/null 2>&1; then
          zig_entry=$(jq -r --arg ver "$zig_version" '.[$ver] // (to_entries[] | select(.value.version == $ver) | .value) // empty' "$index")
          [ -n "$zig_entry" ] && [ "$zig_entry" != "null" ] || { echo "zypher: could not find Zig $zig_version in release index" >&2; exit 1; }
          zig_tarball=$(echo "$zig_entry" | jq -r --arg tgt "$zig_target" '.[$tgt].tarball // empty')
          zig_shasum=$(echo "$zig_entry" | jq -r --arg tgt "$zig_target" '.[$tgt].shasum // empty')
        else
          line_num=$(grep -n -F "$zig_archive_name" "$index" | head -1 | cut -d: -f1)
          [ -n "$line_num" ] || { echo "zypher: could not find Zig $zig_version for $zig_target in release index" >&2; exit 1; }
          zig_tarball=$(sed -n "${line_num}p" "$index" | sed 's/.*"tarball": "\([^"]*\)".*/\1/')
          zig_shasum=$(sed -n "$((line_num + 1))p" "$index" | sed 's/.*"shasum": "\([^"]*\)".*/\1/')
        fi
        [ -n "$zig_tarball" ] && [ -n "$zig_shasum" ] || { echo "zypher: could not resolve download for Zig $zig_version $zig_target" >&2; exit 1; }
        curl -fsSL "$zig_tarball" -o "$tmp_dir/$zig_archive_name"
        if command -v sha256sum >/dev/null 2>&1; then
          actual="$(sha256sum "$tmp_dir/$zig_archive_name" | awk '{ print $1 }')"
          [ "$actual" = "$zig_shasum" ] || { echo "zypher: checksum mismatch for $zig_archive_name" >&2; exit 1; }
        elif command -v shasum >/dev/null 2>&1; then
          actual="$(shasum -a 256 "$tmp_dir/$zig_archive_name" | awk '{ print $1 }')"
          [ "$actual" = "$zig_shasum" ] || { echo "zypher: checksum mismatch for $zig_archive_name" >&2; exit 1; }
        fi
        tar -xJf "$tmp_dir/$zig_archive_name" -C "$tmp_dir"
        rm -rf "$zig_dir.partial-$$"
        mv "$tmp_dir/zig-$zig_target-$zig_version" "$zig_dir.partial-$$"
        rm -rf "$zig_dir"
        mv "$zig_dir.partial-$$" "$zig_dir"
      fi

      if [ ! -f "$source_dir/src/zypher.zig" ]; then
        rm -rf "$source_dir"
        mkdir -p "$source_dir"
        cp -R "#{share}/zypher/source/." "$source_dir/"
      fi

      export PATH="$zig_dir:$PATH"
      export ZYPHER_ROOT="$source_dir"

      if [ "$#" -gt 0 ]; then
        case "$1" in
          run|doc|doc-user)
            cmd="$1"
            shift
            exec "#{libexec}/zypher-bin" "$cmd" --zypher-root "$source_dir" "$@"
            ;;
        esac
      fi

      exec "#{libexec}/zypher-bin" "$@"
    SH
    chmod 0755, bin/"zypher"
  end

  def caveats
    <<~EOS
      To uninstall Zypher and remove all runtime data (~/.zypher), run:
        curl -fsSL https://raw.githubusercontent.com/zypher-org/zypher/main/uninstall.sh | sh
    EOS
  end

  test do
    assert_match "zypher", shell_output("#{bin}/zypher help")
  end
end
